{
  "name": "@pompidup/kingdomino-engine",
  "version": "3.2.0",
  "description": "A simple engine for the game Kingdomino",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pompidup/KDomino.git"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "biome check src/",
    "test": "vitest",
    "coverage": "vitest --coverage --config ./vitest.config.ts",
    "build": "tsup",
    "build:wasm": "pnpm build && javy build dist/wasm-bridge.js -o dist/kingdomino-engine.wasm",
    "bump:major": "npm version major",
    "bump:minor": "npm version minor",
    "bump:patch": "npm version patch",
    "pub": "pnpm build && npm login && npm publish --access public"
  },
  "keywords": [
    "kingdomino",
    "boardgame",
    "engine",
    "typescript"
  ],
  "author": "Pompidup",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Pompidup/KDomino/issues"
  },
  "homepage": "https://github.com/Pompidup/KDomino#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "winston": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "winston": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "winston": "^3.19.0"
  }
}
